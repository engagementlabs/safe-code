FROM golang:1.21-alpine AS builder

WORKDIR /app
COPY enclave-main.go .

# Build args for version info
ARG VERSION=enclave-v1.0
ARG COMMIT_SHA=nitro-enclave
ARG BUILD_TIME=2025-09-10T13:25:00Z

# Build static binary
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X main.Version=$VERSION -X main.CommitSHA=$COMMIT_SHA -X main.BuildTime=$BUILD_TIME" \
    -o bot enclave-main.go

# Runtime image
FROM gcr.io/distroless/static-debian12

# Set Nitro environment
ENV NITRO_ENCLAVE=true

# Copy binary
USER 65534
COPY --from=builder /app/bot /bot

EXPOSE 8080
ENTRYPOINT ["/bot"]