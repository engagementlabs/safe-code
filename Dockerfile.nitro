# Use the regular Dockerfile but build for the target architecture
FROM golang:1.21-alpine AS builder

WORKDIR /app
COPY go.mod .
COPY *.go .

# Build args for version info
ARG VERSION=dev
ARG COMMIT_SHA=unknown
ARG BUILD_TIME=unknown

# Build static binary
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X main.Version=$VERSION -X main.CommitSHA=$COMMIT_SHA -X main.BuildTime=$BUILD_TIME" \
    -o bot .

# Runtime image - use distroless for Nitro
FROM gcr.io/distroless/static-debian12

# Set Nitro environment
ENV NITRO_ENCLAVE=true
ENV NITRO_MOCK=true

# Copy binary
USER 65534
COPY --from=builder /app/bot /bot

EXPOSE 8080
ENTRYPOINT ["/bot"]